# Copy to .env (local) or add in Vercel -> Settings -> Environment Variables.
# Required: the build fails without the three ADMIN_* values.
MONGODB_URI=
GEMINI_API_KEY=
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_JWT_SECRET=
NEXT_PUBLIC_BASE_URL=https://metlinkai.com

# Email (lead forms / auto-replies)
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM_NAME=MetLink
SMTP_REPLY_TO=
CONTACT_TO=
